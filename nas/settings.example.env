# Copy this file into the project folder (next to docker-compose.yml), name it settings.env, and fill in the values.

# Tailscale auth key (admin console > Settings > Keys > Generate auth key). Starts with tskey-auth-
TS_AUTHKEY=tskey-auth-PASTE-YOURS-HERE

# The site's name on your tailnet: https://manyo.<your-tailnet>.ts.net
TS_HOSTNAME=manyo

# Password for the Author area of the site. Make it long.
AUTHOR_PASSWORD=change-me-to-something-long

# How often to check Google Drive for changes, in minutes.
SYNC_INTERVAL_MINUTES=60

# Automatic code updates from GitHub (optional; leave GITHUB_TOKEN empty to turn off).
# A read-only "fine-grained" token for this one repository.
GITHUB_TOKEN=
GITHUB_REPO=momonekomata/Pokemon-Novel
GITHUB_BRANCH=claude/affectionate-lamport-8i272q

# The vault repository (momonekomata/pokemon-novel-vault) holds the novel's text. A read-only
# "fine-grained" token for that one repository, with Contents: Read-only.
# Used by the builder when site.config.json says "source": "vault", and by the Drive mirror.
VAULT_TOKEN=
VAULT_REPO=momonekomata/pokemon-novel-vault
VAULT_BRANCH=main

# How often the Drive mirror checks the vault for changes, in minutes.
MIRROR_INTERVAL_MINUTES=60

# The NAS's own synced copy of the novel's Google Drive folder, used by nas/drive-copy.sh (DSM Task
# Scheduler). File Station → right-click the folder → Properties shows the path. No quotes.
DRIVE_COPY_DIR=
